###############################################
# ビルドステージ
###############################################
FROM node:20-bullseye-slim AS base

# ワークディレクトリの指定
WORKDIR /usr/src/app

# 必要なパッケージのインストール
RUN apt-get update && apt-get -y install

# ソースコードをコンテナにコピー
COPY ../../source/frontend /usr/src/app

###############################################
# 開発用ステージ
###############################################
FROM base AS dev

# 3000番を開放
EXPOSE 3000

###############################################
# 本番用ステージ
###############################################
FROM base AS prod

# パッケージのインストール
RUN npm install

# ビルド
RUN npm run build

# 3000番を開放
EXPOSE 3000

# 起動
CMD ["npm", "run", "start"]
